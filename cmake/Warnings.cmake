add_library(tool_warnings INTERFACE)
if(MSVC)
  target_compile_options(tool_warnings INTERFACE /W4 /permissive-)
  if(TOOL_WARNINGS_AS_ERRORS)
    target_compile_options(tool_warnings INTERFACE /WX)
  endif()
else()
  target_compile_options(tool_warnings INTERFACE -Wall -Wextra -Wpedantic -Wshadow)
  if(TOOL_WARNINGS_AS_ERRORS)
    target_compile_options(tool_warnings INTERFACE -Werror)
  endif()
endif()
